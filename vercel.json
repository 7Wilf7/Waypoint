{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "regions": ["hkg1"],
  "functions": {"api/index.js": {"maxDuration": 60}},
  "redirects": [
    {"source": "/manage.html", "destination": "/manage", "permanent": true},
    {"source": "/manage/", "destination": "/manage", "permanent": true},
    {"source": "/races.html", "destination": "/races", "permanent": true},
    {"source": "/races/", "destination": "/races", "permanent": true}
  ],
  "rewrites": [
    {"source": "/manage", "destination": "/manage.html"},
    {"source": "/races", "destination": "/races.html"},
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/media/:path*", "destination": "/api/index"}
  ],
  "headers": [
    {"source": "/published/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}, {"key": "CDN-Cache-Control", "value": "no-store"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]}
  ]
}
