# Run npm run setup:admin to generate your own local hash and session secret.
WAYPOINT_PASSWORD_HASH=
WAYPOINT_SESSION_SECRET=
# Vercel creates this automatically when connecting a private Blob store.
BLOB_READ_WRITE_TOKEN=
# Server-only Vercel Web Analytics reporting credentials; never use a public prefix.
# Configure only for Production, after enabling the project's free Web Analytics.
WAYPOINT_ANALYTICS_TOKEN=
WAYPOINT_ANALYTICS_PROJECT_ID=
WAYPOINT_ANALYTICS_TEAM_ID=
